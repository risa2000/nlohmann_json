{
  "version": 5,
  "configurePresets": [
    {
      "name": "arch_x64",
      "hidden": true,
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "arm64",
      "hidden": true,
      "architecture": {
        "value": "arm64",
        "strategy": "external"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "generic-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "installDir": "${sourceDir}/out/install/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "clang",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    },
    {
      "name": "clang-cl",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl.exe",
        "CMAKE_CXX_COMPILER": "clang-cl.exe",
        "CMAKE_MT": "mt.exe"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "x64_Debug",
      "displayName": "x64_Debug",
      "inherits": ["generic-base", "arch_x64"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "x64_Release",
      "displayName": "x64_Release",
      "inherits": ["generic-base", "arch_x64"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "x64_Debug_xClang",
      "displayName": "x64_Debug_xClang",
      "inherits": ["clang-cl", "generic-base", "arch_x64"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "x64_Release_xClang",
      "displayName": "x64_Release_xClang",
      "inherits": ["clang-cl", "generic-base", "arch_x64"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "x64_RelWithDebInfo_xClang",
      "displayName": "x64_RelWithDebInfo_xClang",
      "inherits": ["clang-cl", "generic-base", "arch_x64"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "arm64_Debug",
      "displayName": "arm64_Debug",
      "inherits": ["generic-base", "arm64", "clang"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "arm64_Release",
      "displayName": "arm64_Release",
      "inherits": ["generic-base", "arm64", "clang"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "arm64_RelWithDebInfo",
      "displayName": "arm64_RelWithDebInfo",
      "inherits": ["generic-base", "arm64", "clang"],
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "x64_Debug",
      "configurePreset": "x64_Debug"
    },
    {
      "name": "x64_Release",
      "configurePreset": "x64_Release"
    },
    {
      "name": "x64_Debug_xClang",
      "configurePreset": "x64_Debug_xClang"
    },
    {
      "name": "x64_Release_xClang",
      "configurePreset": "x64_Release_xClang"
    },
    {
      "name": "x64_RelWithDebInfo_xClang",
      "configurePreset": "x64_RelWithDebInfo_xClang"
    },
    {
      "name": "arm64_Debug",
      "configurePreset": "arm64_Debug"
    },
    {
      "name": "arm64_Release",
      "configurePreset": "arm64_Release"
    },
    {
      "name": "arm64_RelWithDebInfo",
      "configurePreset": "arm64_RelWithDebInfo"
    }
  ]
}
